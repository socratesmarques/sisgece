# Copie para app.env.local; nunca versione credenciais.
PGHOST=sisgece-db
PGPORT=5432
PGDATABASE=sisgece
PGUSER=sisgece
PGPASSWORD=
# Default seguro: mock, sem rede e sem cobrança.
NOTIFICATIONS_PROVIDER=mock
NOTIFICATIONS_MOCK_OUTCOME=success
WHATSAPP_REAL_SEND_ENABLED=0
# Somente após revisão institucional e configuração manual da conta Meta:
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_CADASTRO=sisgece_cadastro
WHATSAPP_TEMPLATE_APROVACAO=sisgece_aprovacao
WHATSAPP_TEMPLATE_ATUALIZACAO=sisgece_atualizacao
WHATSAPP_TEMPLATE_ETAPA=sisgece_etapa
