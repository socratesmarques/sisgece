# Copie para app.env.local; nunca versione credenciais.
PGHOST=sisgece-db
PGPORT=5432
PGDATABASE=sisgece
PGUSER=sisgece
PGPASSWORD=
# Default seguro: mock, sem rede e sem cobrança.
NOTIFICATIONS_PROVIDER=mock
NOTIFICATIONS_MOCK_OUTCOME=success
WHATSAPP_REAL_SEND_ENABLED=0
# Somente após revisão institucional e configuração manual da conta Meta:
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_CADASTRO=sisgece_cadastro
WHATSAPP_TEMPLATE_APROVACAO=sisgece_aprovacao
WHATSAPP_TEMPLATE_ATUALIZACAO=sisgece_atualizacao
WHATSAPP_TEMPLATE_ETAPA=sisgece_etapa

# Laboratório Evolution API (NÃO usar na implantação institucional).
# Configure somente no ambiente dedicado ao worker de testes.
EVOLUTION_LAB_ENABLED=0
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_INSTANCE=sisgece-teste
EVOLUTION_API_KEY=
EVOLUTION_ALLOWED_RECIPIENTS=
# Também requer NOTIFICATIONS_PROVIDER=evolution e WHATSAPP_REAL_SEND_ENABLED=1.


# Pesquisa de satisfação (desligada por padrão; somente laboratório local).
# No app e no worker: EVOLUTION_FEEDBACK_ENABLED=1 somente depois de homologar.
EVOLUTION_FEEDBACK_ENABLED=0
# Somente no app web, não no worker (mínimo 32 caracteres):
EVOLUTION_FEEDBACK_WEBHOOK_TOKEN=

# Fluxo automático sem checkboxes APENAS em laboratório WSL local.
# No app e no worker: requer EVOLUTION_LAB_ENABLED=1 e allowlist.
EVOLUTION_LAB_AUTO_FLOW=0
