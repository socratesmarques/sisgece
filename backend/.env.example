# O Compose sobrescreve PGHOST=db, PGPORT=5432 e PORT=3000.
PORT=3000
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=sisgece
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Por padrão a porta 8004 fica acessível apenas no servidor.
APP_BIND_ADDRESS=127.0.0.1
# false sem proxy; configure somente IP/CIDR do proxy de confiança.
TRUST_PROXY=false
